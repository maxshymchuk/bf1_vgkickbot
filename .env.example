# EA authentication and machine-specific application settings.
# Fill SID and REMID with EA account cookies named sid and remid.
# Use an account with permission to administer the target BF1 server.
# Paste cookie values only, without the sid= / remid= prefix.
SID=
REMID=

BF1_PATH='<path>'

KICK_WEBHOOK='<url>'
MONITORING_WEBHOOK='<url>'
